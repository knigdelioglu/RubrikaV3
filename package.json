{
  "name": "rubrikav3temp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "npm run typecheck && node scripts/run-frontend-tests.mjs",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "tauri:build": "tauri build",
    "cargo:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "cargo:check": "node scripts/run-cargo.mjs check --manifest-path src-tauri/Cargo.toml --workspace",
    "cargo:clippy": "node scripts/run-cargo.mjs clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "cargo:test": "node scripts/run-rust-tests.mjs",
    "cargo:test:nextest": "node scripts/run-cargo.mjs nextest run --manifest-path src-tauri/Cargo.toml",
    "cargo:test:legacy": "node scripts/run-cargo.mjs test --manifest-path src-tauri/Cargo.toml",
    "check:fast": "npm run typecheck && npm run cargo:check",
    "calibrate:speaking:deterministic": "node scripts/run-cargo.mjs test --manifest-path src-tauri/Cargo.toml calibration_harness_reports_five_zero_variance_backend_runs -- --nocapture",
    "quality": "npm run build && npm run typecheck && npm run lint && npm test && npm run cargo:fmt && npm run cargo:clippy && npm run cargo:test",
    "check:all": "npm run quality"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
